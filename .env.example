# Required in production: signs sessions and encrypts stored tokens + signing keys
VAADA_SECRET_KEY=change-me-to-64-random-characters
VAADA_PUBLIC_URL=https://vaada.yourdomain.com
# sqlite:///./vaada.db for local, postgresql://user:pass@host:5432/vaada for production
DATABASE_URL=sqlite:///./vaada.db
# Sandbox agency + simulator (turn off in production)
VAADA_DEMO_MODE=true
# Run the job worker inside the web process (set false and run `python -m app.worker` separately in production)
VAADA_INLINE_WORKER=true
VAADA_SESSION_HTTPS_ONLY=false
# IWCB clock-skew window around manifest boundaries, seconds
VAADA_BINDING_EPSILON_S=90
# Sentence labeller and booking extractor: rules (offline) | openai | anthropic
VAADA_LABELER=rules
VAADA_EXTRACTOR=rules
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
HIGHLEVEL_VERSION=2021-04-15

# Second reader (optional): rules | groq | anthropic | openai, and vote | fallback
VAADA_EXTRACT_MODE=vote
# ANTHROPIC_API_KEY=
# VAADA_ANTHROPIC_MODEL=claude-haiku-5-5
# GROQ_API_KEY=
# VAADA_GROQ_MODEL=llama-3.3-70b-versatile
