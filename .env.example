# Required in production: signs sessions and encrypts stored tokens + signing keys
LANE_SECRET_KEY=change-me-to-64-random-characters
LANE_PUBLIC_URL=https://lane.yourdomain.com
# sqlite:///./lane.db for local, postgresql://user:pass@host:5432/lane for production
DATABASE_URL=sqlite:///./lane.db
# Sandbox agency + simulator (turn off in production)
LANE_DEMO_MODE=true
# Run the job worker inside the web process (set false and run `python -m app.worker` separately in production)
LANE_INLINE_WORKER=true
LANE_SESSION_HTTPS_ONLY=false
# IWCB clock-skew window around manifest boundaries, seconds
LANE_BINDING_EPSILON_S=90
# Sentence labeller and booking extractor: rules (offline) | openai | anthropic
LANE_LABELER=rules
LANE_EXTRACTOR=rules
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
HIGHLEVEL_VERSION=2021-04-15

# Second reader (optional): rules | groq | anthropic | openai, and vote | fallback
LANE_EXTRACT_MODE=vote
# ANTHROPIC_API_KEY=
# LANE_ANTHROPIC_MODEL=claude-haiku-5-5
# GROQ_API_KEY=
# LANE_GROQ_MODEL=llama-3.3-70b-versatile
